#!/bin/sh
# Runs the native binary that npm/install.js put in native/ next to this script. A shell shim, not
# node, because the parlar hooks run on every tool call and must start in milliseconds.
dir=$(dirname "$(readlink -f "$0")")
name=$(basename "$(readlink -f "$0")")
bin=$dir/native/$name
# Windows (Git Bash, which npm's .cmd shims run this through): the binary has .exe
[ -x "$bin.exe" ] && bin=$bin.exe
if [ ! -x "$bin" ]; then
    echo "$name: native binary missing at $bin; run npm rebuild -g @agent-sh/parlar" >&2
    exit 127
fi
exec "$bin" "$@"
