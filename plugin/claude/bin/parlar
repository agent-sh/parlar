#!/bin/sh
# Runs the installed parlar. Before parlar is installed the plugin must stay out of the way:
# hooks exit quietly, and /parlar:setup explains what to install.
for p in "${PARLAR_BIN:-}" "$HOME/.local/bin/parlar" "$HOME/.cargo/bin/parlar" "$(command -v parlar 2>/dev/null)"; do
    if [ -n "$p" ] && [ -x "$p" ] && [ "$p" != "$0" ]; then
        exec "$p" "$@"
    fi
done
if [ "$1" = "hook" ]; then
    cat >/dev/null
    exit 0
fi
echo "parlar is not installed; run /parlar:setup" >&2
exit 1
