{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook session-start", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook session-end", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook prompt", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook pre-tool", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook post-tool", "timeout": 5 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook post-tool-failure", "timeout": 5 }] }],
    "Stop": [{ "hooks": [
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook stop", "timeout": 5 },
      { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/parley hook wait", "asyncRewake": true, "timeout": 86400 }
    ] }]
  }
}
